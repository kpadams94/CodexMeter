<UserControl x:Class="CodexMeter.QuietCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="143"
             Height="49"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Background="#E0181B22"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="13,11,13,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PercentageLabel"
                           Grid.Column="0"
                           Foreground="#FFFFFFFF"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="10"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Foreground="#7AFFFFFF"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="9"
                           FontWeight="Bold"
                           Text="CODEX"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2"
                    Width="107"
                    Height="3"
                    HorizontalAlignment="Center"
                    Background="#1FFFFFFF"
                    CornerRadius="2"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
                <Border x:Name="ProgressFill"
                        Height="3"
                        HorizontalAlignment="Left"
                        Background="#FFA970FF"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
            </Border>
        </Grid>
    </Border>
</UserControl>
